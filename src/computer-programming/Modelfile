#
# computer-programming
#
# A capability tier tuned for coding work.
#
# See https://docs.ollama.com/modelfile for the full Modelfile reference.
#

# Strong open coding model with broad language coverage and a large context
# window for holding real source files, a full diff, and surrounding code.
FROM qwen2.5-coder:14b

# Low temperature. Coding work rewards correct, deterministic, reproducible
# output over creative variety.
PARAMETER temperature 0.2
PARAMETER top_p 0.9

# Generous context for the most demanding coding task.
PARAMETER num_ctx 32768

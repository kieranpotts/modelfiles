#
# prose-writing
#
# A capability tier tuned for writing clear, accurate English prose.
#
# See https://docs.ollama.com/modelfile for the full Modelfile reference.
#

# General instruction model with strong, fluent prose and good reasoning
# over natural language.
FROM llama3.1:8b

# Moderate temperature to output readable, natural prose without drifting into
# invention. Accuracy matters more than style.
PARAMETER temperature 0.5
PARAMETER top_p 0.9

# Room to hold source material and surrounding documentation.
PARAMETER num_ctx 16384
